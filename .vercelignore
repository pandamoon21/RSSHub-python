# Hide the uv/poetry manifests so Vercel resolves dependencies with pip against
# requirements.txt instead of trying to use a lockfile-based installer.
uv.lock
pyproject.toml
poetry.lock
Pipfile
Pipfile.lock

# NOTE: .python-version is intentionally NOT ignored. Vercel reads it to select the
# Python runtime, and without it the build silently uses Vercel's default version
# rather than the 3.10 this project targets.
